# ---------------------------------------------------------------------------
# Portofino backend configuration. Copy to `.env` and fill in; `npm run dev`
# loads `.env` (Node's --env-file), `npm start` does NOT — a deployed service
# gets these from its own configuration (infra/backend-service.tf).
# Every value has a sensible local default (see src/config.ts); nothing here
# is required to BOOT in local/mock mode — but the kitchen dashboard needs
# either KITCHEN_TOKEN or KITCHEN_AUTH_DISABLED=1 to answer at all, see below.
# ---------------------------------------------------------------------------

# HTTP port the API listens on. The mobile app expects 4000 (see
# mobile/src/lib/config.ts). Change both if you change it.
PORT=4000

# Postgres connection string. Matches docker-compose.yml for local dev.
DATABASE_URL=postgres://portofino:portofino@localhost:5432/portofino

# Public base URL the API is reachable at (used to build payment return URLs).
# Local dev default is http://localhost:${PORT}. In staging this becomes e.g.
# https://api.portofino.qontinui.io
PUBLIC_API_URL=

# Where to send the customer after hosted checkout. Local dev falls back to a
# built-in "payment complete" page. In staging this is the web app origin, e.g.
# https://portofino.qontinui.io
PUBLIC_WEB_URL=

# CORS: comma-separated allowed origins. Empty = allow all (fine for local +
# staging behind a private link). Lock this down before real production.
CORS_ORIGINS=

# --- Stripe (TEST MODE) -----------------------------------------------------
# Use Qontinui's Stripe *test* keys for now. Test mode is fully isolated — no
# real money. Portofino gets its OWN Stripe account before any live payment.
# Leave blank to run Stripe in mock mode (checkout still completes for testing).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Kitchen dashboard ------------------------------------------------------
# Shared secret the kitchen dashboard sends as `Authorization: Bearer <token>`.
# REQUIRED in any deployed environment: with it unset the kitchen routes refuse
# every request rather than serving order data (customer name, phone, address)
# unauthenticated.
KITCHEN_TOKEN=

# Local dev / CI only. Set to 1 to run the kitchen routes with NO auth when
# KITCHEN_TOKEN is blank. Never set this in a deployed environment: it turns
# GET /api/kitchen/orders into a public feed of customer names, phone numbers
# and delivery addresses.
KITCHEN_AUTH_DISABLED=
