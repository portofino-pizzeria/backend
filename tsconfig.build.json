{
  // The emitting build: production sources only. `npm run build` uses this;
  // `npm run typecheck` uses tsconfig.json, which additionally covers `test/`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"]
}
